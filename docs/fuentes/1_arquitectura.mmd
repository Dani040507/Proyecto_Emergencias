flowchart TB
    subgraph Interfaz["1. Capa de interfaz"]
        direction LR
        Consola["Emergencias.Consola<br/>local · cliente remoto · guion"]
        Remoto["Emergencias.ServidorRemoto<br/>spawn/receive · 1 proceso por solicitud"]
        Consola -- "send/receive entre nodos" --> Remoto
    end
    subgraph Aplicacion["2. Capa de aplicación"]
